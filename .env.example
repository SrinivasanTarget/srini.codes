# Copy to .env for local development (`npm run dev` serves /api/voice/* itself).
# On Vercel, set the same variables in the project's Environment Variables.

# Required. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides. Each stage falls back through a list of known
# models when the configured id is not available (see api/_lib/gemini.ts).
# GEMINI_TEXT_MODEL=gemini-3.7-flash
# GEMINI_STT_MODEL=gemini-3.5-transcribe
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Charon

# Optional. Extra origins allowed to call the voice API, comma separated.
# localhost, 127.0.0.1, *.vercel.app and srini.codes are always allowed.
# VOICE_ALLOWED_ORIGINS=https://staging.example.com
